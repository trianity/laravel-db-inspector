{
    "name": "trianity/laravel-db-inspector",
    "description": "An experimental database schema and design inspector for Laravel.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/trianity/laravel-db-inspector",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Trianity\\LaravelDbInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trianity\\LaravelDbInspector\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Istvan Holbok",
            "homepage": "https://github.com/trianity",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "laravel",
        "database",
        "schema",
        "inspection",
        "analysis",
        "mariadb",
        "mysql",
        "postgresql",
        "development-tool"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Trianity\\LaravelDbInspector\\LaravelDbInspectorServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/trianity/laravel-db-inspector/issues",
        "source": "https://github.com/trianity/laravel-db-inspector"
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^11.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "mrpunyapal/peststan": "^0.2.11",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "pest"
        ],
        "test:unit": [
            "pest --testsuite=Unit"
        ],
        "test:feature": [
            "pest --testsuite=Feature"
        ],
        "analyse": [
            "phpstan analyse --debug"
        ],
        "format": [
            "pint"
        ],
        "format:test": [
            "pint --test"
        ]
    }
}
