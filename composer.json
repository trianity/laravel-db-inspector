{
    "name": "trianity/laravel-db-inspector",
    "description": "A production-safe database schema and design inspector for Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Trianity\\LaravelDbInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trianity\\LaravelDbInspector\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Dhanik Keraliya",
            "email": "dhanikk@itpathsolutions.com"
        },
        {
            "name": "Archana Soni",
            "email": "archanau@itpathsolutions.com",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "laravel-db-inspector",
        "laravel",
        "php",
        "performance",
        "database",
        "schema",
        "analysis",
        "trianity"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Trianity\\LaravelDbInspector\\LaravelDbInspectorServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^11.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "pest"
        ],
        "test:unit": [
            "pest --testsuite=Unit"
        ],
        "test:feature": [
            "pest --testsuite=Feature"
        ],
        "analyse": [
            "phpstan analyse --debug"
        ],
        "format": [
            "pint"
        ],
        "format:test": [
            "pint --test"
        ]
    }
}
